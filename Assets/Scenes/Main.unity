  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=230%><color=#F5D17A>EDGEWISE</color></size>\n\u661F\u56F3\u30AB\u30FC\u30C9\u30D0\u30C8\u30EB\uFF08\u4EEE\u984C\uFF09\n\n\n\n<size=150%><color=#F5D17A>\u5236\u4F5C</color></size>\n\n<size=78%><color=#A9B2D1>\u4F01\u753B\u30FB\u30B2\u30FC\u30E0\u30C7\u30B6\u30A4\u30F3\u30FB\u8A66\u904A</color></size>\n<size=120%>magu</size>\n\n<size=78%><color=#A9B2D1>\u8A2D\u8A08\u30FB\u30D7\u30ED\u30B0\u30E9\u30E0\u30FB\u6F14\u51FA</color></size>\nAI
    \u30A8\u30FC\u30B8\u30A7\u30F3\u30C8 Claude\n\uFF08magu \u306E\u6307\u793A\u3068\u76E3\u4FEE\u306E\u3082\u3068\u3067\u5206\u696D\uFF09\n\n\n<size=150%><color=#F5D17A>\u30AB\u30FC\u30C9\u7D75</color></size>\n\ngame-icons.net
    \u306E\u30A2\u30A4\u30B3\u30F3\uFF08CC BY 3.0\uFF09\nLorc \uFF0F Delapouite \uFF0F
    Caro Asercion \uFF0F Skoll \uFF0F Cathelineau\n\u661F\u96F2\u3068\u661F\u5EA7\u3092\u30B7\u30A7\u30FC\u30C0\u30FC\u3067\u91CD\u306D\u3066\u3044\u307E\u3059\uFF08\u6539\u5909\u3042\u308A\uFF09\n\n<size=66%><size=78%><color=#A9B2D1>\u30AB\u30FC\u30C9
    \u2014 \u30A2\u30A4\u30B3\u30F3\uFF08\u4F5C\u8005\uFF09</color></size>\nGlimmouse
    \u2014 mouse (Lorc)\nDustwisp \u2014 ghost (Lorc)\nCoglet \u2014 mono-wheel-robot
    (Delapouite)\nEmberkit \u2014 fox (Caro Asercion)\nScalefry \u2014 axolotl (Caro
    Asercion)\nPyxmoth \u2014 fairy (Lorc)\nBolthare \u2014 rabbit (Delapouite)\nRivetcrab
    \u2014 sad-crab (Lorc)\nFrostnewt \u2014 gecko (Lorc)\nMirelamp \u2014 elysium-shade
    (Delapouite)\nLynxlight \u2014 cat (Lorc)\nGearowl \u2014 owl (Lorc)\nCinderdrake
    \u2014 dimetrodon (Delapouite)\nHollowshade \u2014 spectre (Lorc)\nStonetoad
    \u2014 frog (Lorc)\nVelahound \u2014 sitting-dog (Delapouite)\nClockwyrm \u2014
    centipede (Lorc)\nTidewraith \u2014 jellyfish (Lorc)\nMarshwyvern \u2014 wyvern
    (Lorc)\nVoltsparrow \u2014 swallow (Delapouite)\nLupusfang \u2014 werewolf (Lorc)\nOrreryx
    \u2014 scarab-beetle (Lorc)\nGloamveil \u2014 wing-cloak (Lorc)\nEmberscale \u2014
    velociraptor (Delapouite)\nCorvusarc \u2014 raven (Lorc)\nAquilaburst \u2014
    eagle-emblem (Lorc)\nIroncetus \u2014 dolphin (Delapouite)\nLanternmare \u2014
    cloaked-figure-on-horseback (Caro Asercion)\nSerpenscoil \u2014 cobra (Delapouite)\nRimeloom
    \u2014 djinn (Delapouite)\nLeomane \u2014 lion (Lorc)\nForgecolossus \u2014 robot-golem
    (Lorc)\nAuroraveil \u2014 fairy (Delapouite)\nDraconyx \u2014 hydra (Lorc)\nStormgear
    \u2014 missile-mech (Lorc)\nCygnwraith \u2014 swan (Lorc)\nTaurocrag \u2014 bison
    (Delapouite)\nGravelith \u2014 trilobite (Lorc)\nVoltwyrm \u2014 sea-serpent
    (Lorc)\nNocturnis \u2014 bat (Delapouite)\nOrionmane \u2014 tiger (Delapouite)\nAstrolabion
    \u2014 praying-mantis (Delapouite)\nCassiveil \u2014 mermaid (Delapouite)\nScorpidrake
    \u2014 scorpion (Lorc)\nPolarion \u2014 pterodactylus (Delapouite)\nAndromede
    \u2014 angel-outfit (Lorc)\nPegasion \u2014 pegasus (Skoll)\nOphiwyrm \u2014
    dragon-spiral (Lorc)\nSextantor \u2014 megabot (Lorc)\nUrsamaw \u2014 polar-bear
    (Cathelineau)\n\n<size=78%><color=#A9B2D1>\u7ACB\u3061\u7D75 \u2014 \u30A2\u30A4\u30B3\u30F3\uFF08\u4F5C\u8005\uFF09</color></size>\n\u898B\u7FD2\u3044\u822A\u6D77\u58EB
    \u30DF\u30E9 \u2014 figurehead (Delapouite)\n\u706F\u53F0\u5B88 \u30AA\u30EB\u30C9
    \u2014 monk-face (Delapouite)\n\u6E2F\u306E\u89AA\u65B9 \u30DE\u30FC\u30ED\u30A6
    \u2014 lucky-fisherman (Delapouite)\n\u5199\u672C\u4FC2 \u30EA\u30FC\u30D5 \u2014
    read (Skoll)\n\u53CC\u5B50\u306E\u53F8\u66F8 \u30E6\u30F3\u3068\u30B7\u30A2 \u2014
    face-to-face (Delapouite)\n\u9928\u9577 \u30BB\u30EC\u30B9\u30C8 \u2014 philosopher-bust
    (Caro Asercion)\n\u6C17\u8C61\u5B98 \u30CE\u30A2 \u2014 person-in-blizzard (Lorc)\n\u9727\u306E\u5360\u3044\u5E2B
    \u30F4\u30A7\u30A4\u30EB \u2014 witch-face (Cathelineau)\n\u89B3\u6E2C\u6240\u9577
    \u30A2\u30B9\u30C8\u30E9 \u2014 doctor-face (Lorc)\n\u56DE\u8EE2\u306E\u65C5\u4EBA
    \u30C6\u30AA \u2014 hiking (Delapouite)\n\u661F\u56F3\u306E\u9A0E\u58EB \u30ED\u30FC\u30EC\u30EB
    \u2014 black-knight-helm (Delapouite)\n\u661F\u8A60\u307F\u306E\u9577 \u30A4\u30AA
    \u2014 sun-priest (Delapouite)\n</size>\n\n\n<size=150%><color=#F5D17A>\u97F3\u697D</color></size>\n\n<size=78%><color=#A9B2D1>OpenTracks
    \u306E\u30D5\u30EA\u30FC\u7D20\u6750</color></size>\n\n<size=78%><color=#A9B2D1>\u30BF\u30A4\u30C8\u30EB</color></size>\n\u300C\u661F\u7A7A\u300D
    Heitaro Ashibe\n\n<size=78%><color=#A9B2D1>\u5BFE\u6226</color></size>\n\u300C\u30AE\u30B6\u306A\u30D3\u30FC\u30C8\u300D
    \u30DE\u30CB\u30FC\u30E9\n\n<size=78%><color=#A9B2D1>\u52DD\u5229</color></size>\n\u300C\u660E\u65E5\u3078\u306E\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u300D
    \u306E\u308B\n\n<size=78%><color=#A9B2D1>\u6557\u5317</color></size>\n\u300CToo
    late...\u300D t.tam\n\n<size=78%>https://opentracks.com/</size>\n\n<size=78%>\u52B9\u679C\u97F3\u306F\u3059\u3079\u3066\u30D7\u30ED\u30B0\u30E9\u30E0\u3067\u5408\u6210\u3057\u305F\u97F3\u3067\u3059</size>\n\n\n<size=150%><color=#F5D17A>\u30D5\u30A9\u30F3\u30C8</color></size>\n\nNoto
    Sans JP\n<size=78%>Copyright 2014-2021 Adobe\nSIL Open Font License, Version
    1.1</size>\n\n\n<size=150%><color=#F5D17A>\u8B1D\u8F9E</color></size>\n\n\u30EB\u30FC\u30EB\u306E\u4ED5\u7D44\u307F\u306F\nTriple
    Triad\uFF08\xA9 SQUARE ENIX\uFF09\u3078\u306E\u30AA\u30DE\u30FC\u30B8\u30E5\u3067\u3059\u3002\n\u516C\u5F0F\u3068\u306F\u7121\u95A2\u4FC2\u3067\u3059\u3002\u539F\u4F5C\u306B\u656C\u610F\u3068\u611F\u8B1D\u3092\u3002\n\u7D20\u6575\u306A\u697D\u66F2\u3068\u7D20\u6750\u306E\u4F5C\u8005\u306E\u7686\u3055\u307E\u3001\n\u305D\u3057\u3066\u3001\u3053\u3053\u307E\u3067\u904A\u3093\u3067\u304F\u308C\u305F\u3042\u306A\u305F\u3078\u3002\n\n\n\n\n<size=115%><color=#F5D17A>\u6700\u5F8C\u307E\u3067\u904A\u3093\u3067\u304F\u308C\u3066\u3001\u3042\u308A\u304C\u3068\u3046\u3002</color></size>"
